index 77604c8..fb7a804 100644
--- a/src/duration.js
+++ b/src/duration.js
@@ -1 +1,25 @@
-module.exports = function parseDuration(input) { throw new Error("not implemented"); };
+"use strict";
+const MULT = { h: 3600, m: 60, s: 1 };
+
+module.exports = function parseDuration(input) {
+  if (typeof input !== "string") throw new Error("input must be a string");
+  const str = input.trim();
+  if (!str) throw new Error("empty duration");
+  const re = /(\d+)([a-z]?)\s*/iy;
+  const seen = new Set();
+  let total = 0;
+  let pos = 0;
+  while (pos < str.length) {
+    re.lastIndex = pos;
+    const m = re.exec(str);
+    if (!m) throw new Error("invalid duration: " + input);
+    const unit = m[2].toLowerCase();
+    if (!unit) throw new Error("number without unit: " + input);
+    if (!(unit in MULT)) throw new Error("unknown unit: " + unit);
+    if (seen.has(unit)) throw new Error("repeated unit: " + unit);
+    seen.add(unit);
+    total += Number(m[1]) * MULT[unit];
+    pos = re.lastIndex;
+  }
+  return total;
+};
