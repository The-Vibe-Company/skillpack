diff --git a/src/duration.js b/src/duration.js
index 77604c8..cccb0f1 100644
--- a/src/duration.js
+++ b/src/duration.js
@@ -1 +1,22 @@
-module.exports = function parseDuration(input) { throw new Error("not implemented"); };
+const UNITS = { h: 3600, m: 60, s: 1 };
+
+module.exports = function parseDuration(input) {
+  if (typeof input !== "string") throw new Error("input must be a string");
+  const str = input.trim();
+  if (str === "") throw new Error("empty duration");
+  const re = /(\d+)([a-z])\s*/iy;
+  const seen = new Set();
+  let total = 0;
+  let pos = 0;
+  while (pos < str.length) {
+    re.lastIndex = pos;
+    const m = re.exec(str);
+    if (!m) throw new Error("invalid duration: " + input);
+    const unit = m[2].toLowerCase();
+    if (!(unit in UNITS) || seen.has(unit)) throw new Error("invalid duration: " + input);
+    seen.add(unit);
+    total += parseInt(m[1], 10) * UNITS[unit];
+    pos = re.lastIndex;
+  }
+  return total;
+};
