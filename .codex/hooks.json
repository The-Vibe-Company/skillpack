{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 3,
            "statusMessage": "Skillpack runtime",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/skillpack/usage/hook.mjs\" codex",
