+//# sourceMappingURL=app-page.runtime.prod.js.map
+// Preserve representation negotiation in the runtime used by dynamic serverless pages.
+const pageRoutePrototype = module.exports.AppPageRouteModule.prototype;
+const originalVaryHeader = pageRoutePrototype.getVaryHeader;
+pageRoutePrototype.getVaryHeader = function(resolvedPathname, interceptionRoutePatterns) {
+    const vary = originalVaryHeader.call(this, resolvedPathname, interceptionRoutePatterns);
